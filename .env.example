# ==========================================
# SmartSympo - Unified Environment Configuration
# ==========================================

# Server Configuration
PORT=5000

# Backend & Relay SMTP Email Configuration (Nodemailer Gmail)
GMAIL_USER=your_gmail_account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Client Configuration
VITE_API_URL=http://localhost:5000

# Supabase Realtime & Database Configuration
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional EmailJS Keys (Fallback)
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_WELCOME_TEMPLATE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Optional AI Assistant Keys
# VITE_GEMINI_API_KEY=
# VITE_OPENAI_API_KEY=
